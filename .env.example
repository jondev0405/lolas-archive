# Copy this file to .env before starting the app:
#   Copy-Item .env.example .env
# Every value below is safe for local development and points at this machine only.

# Local SQLite database used by Prisma. Keep this path relative to the project root.
DATABASE_URL="file:./dev.db"

# Local Ollama service and the model used for extraction.
# Pull the model first: ollama pull gemma3:4b-it-qat
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:4b-it-qat"

# Local FastAPI + faster-whisper service.
TRANSCRIBE_URL="http://localhost:8000"

# Optional. Set to "en", "tl", etc. to force a transcription language.
# Leave blank to let Whisper auto-detect.
WHISPER_LANGUAGE=

# Optional. faster-whisper model size read by python/main.py (default "base").
# Set it in the PowerShell session before starting the Python service; uvicorn does
# not load this file for Python. Uncomment to override.
# WHISPER_MODEL="base"
