{
  "name": "lolas-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,whisper -c blue,magenta \"next dev\" \"python/.venv/Scripts/python -m uvicorn main:app --app-dir python --port 8000\"",
    "build": "next build",
    "start": "next start",
